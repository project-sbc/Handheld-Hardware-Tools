<classes:ControllerUserControl x:Class="Handheld_Hardware_Tools.UserControls.CommonUserControl_SliderToggleSwitch"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
 xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
 xmlns:local="clr-namespace:Handheld_Hardware_Tools.UserControls.HomePageUserControls"
 xmlns:classes="clr-namespace:Handheld_Hardware_Tools.Classes.Controller_Object_Classes"  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                   mc:Ignorable="d" Height="170" HorizontalAlignment="Stretch"  >
    <Border Style="{StaticResource userControlBorder}" Name="border">
        <ui:CardExpander VerticalAlignment="Stretch"  x:Name="card" >
            <ui:CardExpander.Header>
                <Grid VerticalAlignment="Stretch">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MaxWidth="50" />
                        <ColumnDefinition Width="5"  />
                        <ColumnDefinition Width="4*"/>
                        <ColumnDefinition Width="5"  />
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Viewbox x:Name="viewboxIconSymbol"  Visibility="{Binding symbolIconVisibility}">
                        <ui:SymbolIcon Symbol="{Binding Path=symbolRegular}"      />

                    </Viewbox>
                    <Viewbox x:Name="viewboxIconFont" Visibility="{Binding fontIconVisibility}" >
                        <ui:FontIcon Glyph="{Binding Path=glyph}"     />
                    </Viewbox>


                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="3*" />
                            <RowDefinition Height="3" />
                            <RowDefinition Height="2*"/>
                        </Grid.RowDefinitions>
                        <Viewbox   HorizontalAlignment="Left" VerticalAlignment="Center" Grid.RowSpan="{Binding Path=mainTextSpan}">
                            <TextBlock Text="{Binding Path=mainText}"  />
                        </Viewbox>

                        <Viewbox  HorizontalAlignment="Left" Grid.Row="2" Visibility="{Binding Path=subTextVisibility}">
                            <TextBlock Text="{Binding Path=subText}" TextWrapping="Wrap" />
                        </Viewbox>
                    </Grid>


                    <ui:ToggleSwitch x:Name="toggleSwitch" IsChecked="{Binding Path=IsExpanded, ElementName=card}" Grid.Column="4" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,20,0" DockPanel.Dock="Right" Checked="toggleSwitch_Checked" Unchecked="toggleSwitch_Unchecked"/>


                </Grid>
            </ui:CardExpander.Header>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Slider x:Name="slider" Minimum="0" Maximum="10" IsSnapToTickEnabled="True" Interval="1" TickFrequency="1" Margin="5,5,5,0" Thumb.DragCompleted="slider_DragCompleted"  Thumb.DragStarted="slider_DragStarted"  />

                <Viewbox Grid.Column="1"  >

                    <TextBlock  >
                        <TextBlock.Text>
                            <MultiBinding StringFormat="{}{0} {1}">
                                <Binding ElementName="slider" Path="Value" />
                                <Binding Path="valueText" />
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>


                </Viewbox>
            </Grid>
            
           
        </ui:CardExpander>

    </Border>

    </classes:ControllerUserControl>

